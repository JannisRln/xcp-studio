#!/bin/sh
# Reject commits with unformatted Rust files. Run `cargo fmt --all` to fix.
set -eu
if ! command -v cargo >/dev/null 2>&1; then
  echo "cargo not found; install the Rust toolchain from rustup" >&2
  exit 1
fi
cargo fmt --all -- --check || {
  echo "Rust formatting failed. Run: cargo fmt --all" >&2
  exit 1
}
